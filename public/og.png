<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0a0a"/>
      <stop offset="50%" stop-color="#0f1018"/>
      <stop offset="100%" stop-color="#1a0a24"/>
    </linearGradient>
    <linearGradient id="title" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00f0ff"/>
      <stop offset="60%" stop-color="#d946ef"/>
      <stop offset="100%" stop-color="#a855f7"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <g opacity="0.15" stroke="#00f0ff" stroke-width="1">
    <line x1="0" y1="80" x2="1200" y2="80"/><line x1="0" y1="160" x2="1200" y2="160"/>
    <line x1="0" y1="240" x2="1200" y2="240"/><line x1="80" y1="0" x2="80" y2="630"/>
    <line x1="160" y1="0" x2="160" y2="630"/>
  </g>
  <circle cx="980" cy="120" r="140" fill="none" stroke="#00f0ff" stroke-width="1" opacity="0.25"/>
  <circle cx="980" cy="120" r="200" fill="none" stroke="#d946ef" stroke-width="1" opacity="0.15"/>
  <text x="80" y="140" fill="#00f0ff" font-family="system-ui,sans-serif" font-size="22" letter-spacing="12" opacity="0.9">BLUE TEAM SOC</text>
  <text x="80" y="280" fill="url(#title)" font-family="system-ui,sans-serif" font-size="88" font-weight="800" filter="url(#glow)">BreachMark</text>
  <text x="80" y="350" fill="#f0f9ff" font-family="system-ui,sans-serif" font-size="32" font-weight="500">Simulate. Respond. Get Marked.</text>
  <text x="80" y="420" fill="#94a3b8" font-family="ui-monospace,monospace" font-size="24">12 credits · live timeline · blast-radius graph</text>
  <rect x="80" y="480" width="280" height="52" rx="12" fill="none" stroke="#00f0ff" stroke-width="2" opacity="0.6"/>
  <text x="110" y="514" fill="#00f0ff" font-family="system-ui,sans-serif" font-size="20" font-weight="600">breachmark.vercel.app</text>
</svg>
